database -open waves -into waves.shm -default
probe -create -shm multiplier32FP_tb.a_i multiplier32FP_tb.b_i multiplier32FP_tb.clk multiplier32FP_tb.done_o multiplier32FP_tb.fd multiplier32FP_tb.i multiplier32FP_tb.infinit_o multiplier32FP_tb.nan_o multiplier32FP_tb.nv multiplier32FP_tb.overflow_o multiplier32FP_tb.product_o multiplier32FP_tb.rst_n multiplier32FP_tb.sr multiplier32FP_tb.start_i multiplier32FP_tb.ta multiplier32FP_tb.tb multiplier32FP_tb.underflow_o multiplier32FP_tb.va multiplier32FP_tb.vb
run 1000
reset
run 1000ns
run 1000ns
reset
run 1000ns
run 1000ns
exit
